# ===================================================
# Falcon YT Analytics - Environment Configuration
# ===================================================

# [Frontend Settings - Vercel / Local]
# Master passcode for Single Admin Access (Set your own secret password)
VITE_ADMIN_PASSCODE=your_secret_admin_passcode_here

# Optional: URL of your hosted backend if frontend is deployed on Vercel
# e.g., https://falcon-backend.onrender.com (leave empty for local dev proxy)
VITE_API_BASE_URL=

# [Backend Settings]
# Admin authentication key for backend API protection
FALCON_ADMIN_KEY=your_secret_backend_key_here
REQUIRE_AUTH=false

# Google YouTube Data API v3 & OAuth Credentials
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
